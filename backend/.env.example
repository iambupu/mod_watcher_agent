# LLM / AI 供应商设置
# LLM_PROVIDER=openai           # 可选供应商: openai, anthropic, gemini, groq, deepseek, openrouter, ollama
# LLM_API_KEY=                  # 通用 API Key，用于当前供应商（OpenAI 用户兼容旧 OPENAI_API_KEY 变量）
# LLM_MODEL=                    # 模型名称，按供应商默认值自动填充（如 gpt-4o-mini, claude-3-5-haiku-latest, gemini-2.0-flash）
# LLM_BASE_URL=                 # 基础 URL，仅 OpenAI 兼容模式使用，默认每个供应商有预置地址
